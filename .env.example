# BOSSman configuration. Copy to .env and fill in. Never commit .env.
# Generate strong values with:  python -c "import secrets; print(secrets.token_urlsafe(32))"

# ── Credentials (bootstrap; create scoped keys later with `bossman keys create`) ──
BOSSMAN_ADMIN_TOKEN=change-me-admin-token          # full control (keys, secrets, policies)
BOSSMAN_OPERATOR_TOKEN=change-me-operator-token    # approve actions, replay DLQ, send directives
BOSSMAN_AGENT_TOKEN=change-me-agent-token          # agents connect with this (BOSSMAN_API_KEY on the agent side)
BOSSMAN_AGENT_TOKEN_NAMESPACES=*                   # namespaces the bootstrap agent token may use
BOSSMAN_AGENT_MAX_TIER=WRITE                       # highest permission tier it may register agents with
# BOSSMAN_VIEWER_TOKEN=                            # read-only dashboard access

# Encryption key for stored secrets (any passphrase, or a Fernet key). REQUIRED in production.
BOSSMAN_SECRET_KEY=change-me-secret-key

# ── Deployment ────────────────────────────────────────────────────────────────
BOSSMAN_ENV=production                 # production: private reads, no API docs
BOSSMAN_PUBLIC_READS=true              # dashboard reads without a token (only on trusted networks)
# BOSSMAN_MODE=standalone|distributed  # compose sets distributed
# BOSSMAN_PERSISTENCE=memory|sql       # compose sets sql
# DATABASE_URL=postgresql+asyncpg://bossman:bossman@localhost:5440/bossman   # or sqlite+aiosqlite:///bossman.db
# REDIS_URL=redis://localhost:6390/0
POSTGRES_PASSWORD=bossman
BOSSMAN_PORT=7070
BOSSMAN_PUBLIC_URL=http://localhost:7070   # URL managed agents use to reach BOSSman

# ── Supervision ───────────────────────────────────────────────────────────────
HEARTBEAT_INTERVAL_SECONDS=10
HEARTBEAT_TIMEOUT_SECONDS=30
MAX_AGENT_RESTARTS=3
RESTART_WINDOW_SECONDS=60
# BOSSMAN_ROLE_LIMITS=memory-sync=1,default/researcher=10    # spawn caps per role
# BOSSMAN_RETENTION_DAYS=30

# ── Fleet-wide LLM limit (the built-in "llm" limit) ────────────────────────────
LLM_MAX_CONCURRENT=20
LLM_RATE_PER_SECOND=2.0
LLM_BURST=10

# ── LLM diagnostics (optional): rules first, Claude for novel failures ─────────
# ANTHROPIC_API_KEY=
# BOSSMAN_LLM_MODEL=claude-opus-5-5
# BOSSMAN_LLM_EFFORT=low
# BOSSMAN_JUDGE_SAMPLE_RATE=0.0        # fraction of completed tasks graded by an LLM judge

# ── Observability (optional) ──────────────────────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318   # Jaeger / Langfuse / LangSmith / Datadog via OTLP
# OTEL_SERVICE_NAME=bossman
# BOSSMAN_METRICS_PUBLIC=1             # /metrics without auth (scrape from inside your network)

# ── Kubernetes (optional) ─────────────────────────────────────────────────────
# BOSSMAN_K8S_RESTART=1                # restart agent pods by deleting them (needs RBAC; Helm sets it)

# ── Chaos engineering (never in production) ───────────────────────────────────
# BOSSMAN_ENABLE_FAULTS=1
