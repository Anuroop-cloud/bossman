# BOSSman Environment Configuration
# Copy this file to .env and fill in your actual credentials / configurations.

# ── LLM Provider API Keys ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ── LLM Configuration ────────────────────────────────────────────────────────
LLM_PRIMARY_MODEL=claude-3-7-sonnet-20250219
LLM_FALLBACK_MODEL=claude-3-5-haiku-20241022
LLM_MAX_CONCURRENT=20          # Semaphore cap for concurrent LLM calls
LLM_MAX_RETRIES=5
LLM_BASE_DELAY=1.0
LLM_MAX_DELAY=60.0

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://bossman:bossman@localhost:5432/bossman
DATABASE_ECHO=false

# ── Redis (Phase 3+) ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── LangSmith & Tracing ──────────────────────────────────────────────────────
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=bossman
LANGCHAIN_TRACING_V2=true

# ── BOSSman Core Settings ──────────────────────────────────────────────────
BOSSMAN_ENV=development
BOSSMAN_LOG_LEVEL=INFO
HEARTBEAT_INTERVAL_SECONDS=10
HEARTBEAT_TIMEOUT_SECONDS=30
MAX_AGENT_RESTARTS=3
RESTART_WINDOW_SECONDS=60
TOKEN_BUDGET_DEFAULT=50000

# ── API Server & Dashboard ───────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
WS_HEARTBEAT_INTERVAL=5
